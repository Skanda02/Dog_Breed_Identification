# Copy to .env (or set on your deployment platform). Never commit real secrets.

# --- Backend ---
# HTTP port the Flask server listens on. Deploy platforms inject this via $PORT.
PORT=5001

# Absolute or relative path to the built frontend (frontend/dist). Serves the
# React app from the backend. Leave unset in local dev to run API-only.
# FRONTEND_DIST=./dist

# Set to 1 to run Flask in debug mode (local dev only).
FLASK_DEBUG=0

# --- Frontend (build-time) ---
# Base URL of the backend API. Leave unset when the backend serves the frontend
# so requests use the relative "/api" path.
# VITE_API_URL=http://localhost:5001/api
